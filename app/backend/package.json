{
  "name": "do-re-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run --coverage",
    "test:unit": "SKIP_DYNAMO=1 vitest run",
    "dev": "esbuild dev/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/dev-server.cjs --log-level=warning && node dist/dev-server.cjs",
    "library": "esbuild scripts/buildLibrary.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/build-library.mjs --log-level=warning && node dist/build-library.mjs",
    "library:pull": "esbuild scripts/pullLibrary.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/pull-library.mjs --log-level=warning && node dist/pull-library.mjs",
    "push:keys": "esbuild scripts/pushKeys.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/push-keys.cjs --log-level=warning && node dist/push-keys.cjs",
    "bundle": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --loader:.csv=text --outfile=dist/lambda.cjs",
    "build": "sam build",
    "deploy": "sam build && sam deploy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1176.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@aws-sdk/client-sns": "^3.1178.0",
    "@aws-sdk/client-ssm": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1176.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.11.0",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
