# Copy to .env.local (git-ignored) to run the app against the real backend.
# Leave VITE_API_BASE_URL unset to run the in-memory demo with fake users.
# It is read at build time, so restart `npm run dev` or rebuild after changing it.

# Local backend: run `npm run dev` in ../backend first (real backend code, data in memory).
VITE_API_BASE_URL=http://localhost:8787/api

# Deployed backend: the `ApiBaseUrl` output of the backend stack (same origin as the app).
# VITE_API_BASE_URL=https://<distribution>.cloudfront.net/api
